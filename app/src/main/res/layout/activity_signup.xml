<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/my_primary"
    android:visibility="visible"
    tools:context=".MainActivity">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/logwallpapaer" />

    <!-- CardView with rounded corners -->
    <androidx.cardview.widget.CardView
        android:id="@+id/myCard"
        android:layout_width="900px"
        android:layout_height="1600px"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:alpha="0.9"
        app:cardBackgroundColor="#D9D9D9"
        app:cardCornerRadius="30dp"
        app:cardElevation="8dp">

        <!-- ConstraintLayout inside CardView for free positioning -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- TextView you can drag freely in Design view -->
            <TextView
                android:id="@+id/myText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:padding="20dp"
                android:text="Login"
                android:textColor="#082108"
                android:textSize="48sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />



            <androidx.cardview.widget.CardView
                android:layout_width="300dp"
                android:layout_height="100px"
                app:cardCornerRadius="30dp"
                tools:layout_editor_absoluteX="21dp"
                tools:layout_editor_absoluteY="233dp">

                <EditText
                    android:id="@+id/editTextTextEmailAddress3"
                    android:layout_width="300dp"
                    android:layout_height="100px"
                    android:background="@null"
                    android:ems="10"
                    android:inputType="textEmailAddress"

                    android:text="   Email" />
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/button"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#93A267"
                android:text="Signup"
                tools:layout_editor_absoluteX="27dp"
                tools:layout_editor_absoluteY="437dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="300dp"
                android:layout_height="100px"
                app:cardCornerRadius="30dp"
                tools:layout_editor_absoluteX="21dp"
                tools:layout_editor_absoluteY="165dp" >

                <EditText
                    android:id="@+id/editTextText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@null"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:text="Name" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="300dp"
                android:layout_height="100px"
                app:cardCornerRadius="30dp"
                tools:layout_editor_absoluteX="21dp"
                tools:layout_editor_absoluteY="299dp">

                <EditText
                    android:id="@+id/editTextText2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@null"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:text="Password" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="300dp"
                android:layout_height="100px"
                app:cardCornerRadius="30dp"
                tools:layout_editor_absoluteX="21dp"
                tools:layout_editor_absoluteY="361dp" >

                <EditText
                    android:id="@+id/editTextText3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="@null"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingStart="10dp"
                    android:text="Re Enter Password" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back to login"
                android:textColor="#082108"
                tools:layout_editor_absoluteX="27dp"
                tools:layout_editor_absoluteY="14dp" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
